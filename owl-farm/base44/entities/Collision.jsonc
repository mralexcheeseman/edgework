{
  "name": "Collision",
  "type": "object",
  "properties": {
    "source_item": {
      "type": "string"
    },
    "position": {
      "type": "string"
    },
    "relation": {
      "type": "string",
      "enum": [
        "supports",
        "challenges",
        "extends"
      ]
    },
    "why": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "new",
        "kept",
        "killed"
      ],
      "default": "new"
    },
    "reaction": {
      "type": "string"
    },
    "picked_at": {
      "type": "string",
      "format": "date-time",
      "description": "When this collision was last sent to Telegram as the day's pick"
    },
    "tg_update": {
      "type": "number",
      "description": "Last Telegram update handled for this collision, so a retried webhook isn't drafted twice"
    }
  },
  "required": [
    "source_item",
    "position",
    "relation"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
