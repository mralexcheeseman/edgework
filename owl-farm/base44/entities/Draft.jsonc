{
  "name": "Draft",
  "type": "object",
  "properties": {
    "format": {
      "type": "string",
      "enum": [
        "dispatch",
        "hey_rube",
        "expense_report",
        "essay",
        "routine"
      ]
    },
    "title": {
      "type": "string"
    },
    "body": {
      "type": "string"
    },
    "deck": {
      "type": "string",
      "description": "One-sentence standfirst under the title"
    },
    "pull": {
      "type": "string",
      "description": "The line worth repeating; *asterisks* mark the phrase to highlight on cards"
    },
    "reaction": {
      "type": "string"
    },
    "lenses": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "idea",
        "drafted",
        "edited",
        "exported",
        "published"
      ],
      "default": "idea"
    },
    "spark": {
      "type": "string"
    },
    "collision": {
      "type": "string"
    },
    "go_deeper": {
      "type": "string",
      "description": "Further reading shown under the piece: one item per line, 'Title | URL | why it's worth reading'"
    },
    "caption": {
      "type": "string",
      "description": "Social caption for the card: makes sense on its own, credits the source and who they are"
    },
    "original_title": {
      "type": "string",
      "description": "The title as the Desk first wrote it, kept so Owl Farm can learn from Alex's edits"
    },
    "original_body": {
      "type": "string",
      "description": "The body as the Desk first wrote it, kept so Owl Farm can learn from Alex's edits"
    },
    "lesson_checked": {
      "type": "boolean",
      "description": "True once 'Learn from edits' has compared this draft with what Alex shipped"
    },
    "post_url": {
      "type": "string",
      "description": "Where the card was posted (LinkedIn, Instagram)"
    },
    "reach": {
      "type": "number",
      "description": "Impressions or views a week after posting"
    },
    "engagements": {
      "type": "number",
      "description": "Reactions, comments, reposts and saves a week after posting"
    },
    "tg_update": {
      "type": "number",
      "description": "Last Telegram update handled for this draft, so a retried webhook isn't drafted twice"
    }
  },
  "required": [
    "format"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
