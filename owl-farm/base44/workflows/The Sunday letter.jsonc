{
  "name": "The Sunday letter",
  "description": "Sundays: builds the week's Edgework email from published drafts and sends it to Alex to paste into Beehiiv.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 17 * * 0",
      "one_time_date": null,
      "timezone": "Europe/London",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "do": [
      {
        "digest": {
          "call": "invoke_backend_function",
          "then": "end",
          "with": {
            "function_name": "weeklyDigest",
            "payload": {
              "key": "<OWL_WIRE_KEY: set in Base44 secrets>"
            }
          }
        }
      }
    ],
    "document": {
      "dsl": "1.0.0",
      "name": "the-sunday-letter",
      "namespace": "base44",
      "version": "1.0.0"
    }
  }
}
