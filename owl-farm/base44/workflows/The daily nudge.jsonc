{
  "name": "The daily nudge",
  "description": "Emails Alex the day's routine with links at 07:30, then at 12:30, 18:30 and 21:30 if a step is still open.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "30 7,12,18,21 * * *",
      "one_time_date": null,
      "timezone": "Europe/London",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "do": [
      {
        "sendNudge": {
          "call": "invoke_backend_function",
          "then": "end",
          "with": {
            "function_name": "dailyNudge",
            "payload": {}
          }
        }
      }
    ],
    "document": {
      "dsl": "1.0.0",
      "name": "daily-nudge",
      "namespace": "base44",
      "version": "1.0.0"
    }
  }
}